# OXANA / PII API — server-side only. NEVER prefix these with VITE_.
# Local: copy to server/.env
# Timeweb App Platform: set the same names in the application panel. Do not upload this file.

PORT=8787
HOST=0.0.0.0
NODE_ENV=development

# Russian Postgres. Prefer the private host when the API runs inside Timeweb.
# Do not put a real password here.
PII_DATABASE_URL=
PII_ENCRYPTION_KEY=
# PII_HMAC_KEY=

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Path or PEM. Relative paths resolve from the server/ package root.
PII_DB_CA_CERT_PATH=./certs/root.crt
CONSENT_VERSION=2026-08-pd3

# Site origin + local cabinet. Add the Timeweb frontend domain before cutover.
CORS_ORIGINS=http://localhost:5173,https://your-frontend.example

# OXANA_AUTH_PROVIDER=supabase

# Same cluster as PII is allowed; schema must be oxana, user oxana_app.
OXANA_DATABASE_URL=
# OXANA_DB_SSL=disable
OXANA_DB_CA_CERT_PATH=./certs/root.crt
# Optional PEM instead of a file (useful in the Timeweb panel):
# OXANA_DB_CA_CERT=
OXANA_ALLOWED_USER_IDS=

# Leave unset in production so reminders run in this process.
# OXANA_REMINDERS=disable

# GigaChat is not enabled yet.
# GIGACHAT_AUTH_KEY=
# GIGACHAT_CLIENT_ID=
